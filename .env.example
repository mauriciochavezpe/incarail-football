# Variables para `docker compose` (copiar a .env). NUNCA subas el .env al repositorio.

# Token gratuito de https://www.football-data.org
FOOTBALL_DATA_TOKEN=

# Puertos publicados en tu máquina.
API_PORT=8000
WEB_PORT=5173

# Contraseña de PostgreSQL dentro de Docker.
DB_PASSWORD=football

# Opcional: si lo dejas vacío, el contenedor genera una APP_KEY y la guarda en su volumen.
APP_KEY=
